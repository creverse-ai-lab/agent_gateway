{
  "name": "acp-gateway-daemon",
  "version": "1.7.1",
  "description": "Persistent local ACP gateway with Main-only control and worker-safe guidance.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/creverse-ai-lab/agent_gateway.git"
  },
  "homepage": "https://github.com/creverse-ai-lab/agent_gateway#readme",
  "bugs": {
    "url": "https://github.com/creverse-ai-lab/agent_gateway/issues"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src/",
    "gateway-client/",
    "skills/",
    "docs/",
    "npm-shrinkwrap.json",
    "README.md",
    "README.*.md",
    "CHANGELOG.md",
    "CHANGELOG.*.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./gateway-client/index.js",
    "./client": "./gateway-client/index.js"
  },
  "bin": {
    "acp-gateway": "src/index.js",
    "acp-mcp-bridge": "src/index.js",
    "acp-gateway-control": "src/index.js",
    "acp-gateway-guide": "src/guide.js",
    "acp-gateway-daemon": "src/gateway-daemon.js",
    "acp-gateway-bootstrap": "src/bootstrap.js",
    "acp-gateway-admin": "src/admin.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "daemon": "node src/gateway-daemon.js",
    "guide": "node src/guide.js",
    "bootstrap": "node src/bootstrap.js",
    "test": "sh -c 'export ACP_GATEWAY_DISABLE_DYNAMIC_PROVIDERS=1 ACP_GATEWAY_ARTIFACTS=\"$(mktemp -d)\"; node --test test/*.test.js; s=$?; rm -rf \"$ACP_GATEWAY_ARTIFACTS\"; exit $s'",
    "test:persistence:stress": "node scripts/stress-persistence.js",
    "bench:payload": "node scripts/bench-payload.js",
    "release:runtime": "node scripts/build-runtime-release.js",
    "release:verify": "node scripts/verify-runtime-release.js",
    "smoke": "node test/live-smoke.js",
    "smoke:subagents": "node test/live-subagent-smoke.js",
    "smoke:npm": "node scripts/npm-smoke.js",
    "usecases:live": "node scripts/live-usecases.js",
    "ci": "node scripts/ci-check.js && node scripts/acp-upstream-monitor.js --validate && npm test && node scripts/bench-payload.js",
    "monitor:check": "node scripts/acp-upstream-monitor.js",
    "monitor:update": "node scripts/acp-upstream-monitor.js --update",
    "monitor:sync-dependencies": "node scripts/sync-acp-dependencies.js",
    "update:upstream": "npm run monitor:update && npm run monitor:sync-dependencies && npm run ci"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.64.2",
    "@modelcontextprotocol/sdk": "1.30.0"
  },
  "engines": {
    "node": ">=22"
  }
}
